{"id":"r94aqLUO0wo","de":"manual","ar":null,"cues":[{"s":0.92,"e":10.8,"de":"Hallo Leute, das ist unsere neue Serie: Super Easy German."},{"s":10.8,"e":17.31,"de":"Das ist so einfach, dass jeder Deutsch lernen kann."},{"s":17.31,"e":21.92,"de":"Los geht's."},{"s":21.92,"e":25.67,"de":"Wir müssen auch langsam gehen."},{"s":25.67,"e":28.17,"de":"Wer ist das?"},{"s":28.17,"e":30.76,"de":"Das ist Walt."},{"s":30.76,"e":32.45,"de":"Wie heisst du?"},{"s":32.45,"e":38.19,"de":"Ich heisse Walt."},{"s":38.19,"e":46.57,"de":"Auf Deutsch heisst Walt - Walter."},{"s":46.57,"e":48.87,"de":"Wo kommst du her?"},{"s":48.87,"e":54.99,"de":"Ich komme aus den USA."},{"s":54.99,"e":58.15,"de":"Waw."},{"s":58.15,"e":62.51,"de":"Walt ist Matematiker."},{"s":62.51,"e":68.66,"de":"Walt, warum bist du in Deutschland?"},{"s":68.66,"e":73.9,"de":"Ich lerne Deutsch."},{"s":73.9,"e":80.24,"de":"Walt, wie alt bist du."},{"s":80.24,"e":84.59,"de":"Ich bin 26."},{"s":84.59,"e":88.96,"de":"Walt ist 26 Jahre alt."},{"s":88.96,"e":93.37,"de":"Walt, welche Hobbies hast du?"},{"s":93.37,"e":96.82,"de":"Aa, ganz viele."},{"s":96.82,"e":101.38,"de":"Jetzt zeigen wir euch Walt Hobbies."},{"s":101.38,"e":115.84,"de":"Walt's Hobby ist Laufen."},{"s":115.84,"e":118.37,"de":"Walt's Hobby ist Einkaufen."},{"s":118.37,"e":126.26,"de":"Walt kauft ein Eis."},{"s":126.26,"e":134.98,"de":"Walt isst gerne Eis."},{"s":134.98,"e":139.56,"de":"Walt's Hobby ist mit Freunden abhängen."},{"s":139.56,"e":141.78,"de":"Walt hast du Geschwister?"},{"s":141.78,"e":150.4,"de":"Ja, ich habe einen Bruder und eine Schwester."},{"s":150.4,"e":151.43,"de":"Toll."},{"s":151.43,"e":162.66,"de":"Ich habe auch eine Schwester."},{"s":162.66,"e":164.84,"de":"Walt's Hobby ist Gewichtehebben."}]}